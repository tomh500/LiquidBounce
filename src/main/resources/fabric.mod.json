{
  "schemaVersion": 1,
  "id": "liquidbounce",
  "version": "${version}",
  "name": "LiquidBounce",
  "description": "A free mixin-based injection hacked-client for Minecraft using the Fabric modding toolchain.",
  "authors": [
    "CCBlueX"
  ],
  "contributors": $contributors,
  "contact": {
    "homepage": "https://liquidbounce.net/",
    "sources": "https://github.com/CCBlueX/LiquidBounce/",
    "issues": "https://github.com/CCBlueX/LiquidBounce/issues",
    "email": "support@liquidbounce.net"
  },
  "license": "GNU General Public License v3.0",
  "icon": "resources/liquidbounce/icon_64x64.png",
  "environment": "client",
  "provides": [
    "malilib"
  ],
  "entrypoints": {
    "main": [],
    "client": [
      "net.ccbluex.liquidbounce.integration.RikkaDynamicLightsInitializer",
      "net.ccbluex.liquidbounce.integration.MergedModulesInitializer"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "liquidbounce.generic.forum": "https://forums.ccbluex.net/"
      }
    }
  },
  "mixins": [
    "liquidbounce.mixins.json",
    "lambdynlights.mixins.json",
    "lambdynlights.lightsource.mixins.json",
    "liquidbounce.pathing.mixins.json",
    "liquidbounce.malilib.mixins.json",
    "liquidbounce.cloudmusic.mixins.json"
  ],
  "depends": {
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${min_loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  },
  "suggests": {
    "fabric": ">=${fabric_version}",
    "viafabricplus": ">=${viafabricplus_version}"
  },
  "breaks": {
    "viafabricplus": "<${viafabricplus_version}",
    "cloudmusic": "*"
  },
  "accessWidener": "liquidbounce.accesswidener"
}
